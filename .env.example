POSTGRES_DB=inventory
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_strong_password_here
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://your-domain.com

# vanam-hr 캘린더 연동
HR_CALENDAR_SYNCER_URL=http://hr-calendar-syncer:8765

# vanam-hr calendar-syncer 호출용 머신 토큰 (재고앱 → 캘린더)
# 생성 예: openssl rand -hex 32
INTERNAL_API_TOKEN=

# OpenClaw MCP 서버가 내부 조회 API (/api/internal/*) 호출 시 인증용
# 생성 예: openssl rand -hex 32 — 위의 INTERNAL_API_TOKEN(캘린더 연동용)과는 다른 값을 사용할 것
MCP_API_TOKEN=
